{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voltune",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The website: Vite builds it into dist/, Cloudflare serves it as static assets.
  "build": { "command": "npm run build:web" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/setup", "/setup/*", "/mcp/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STUDIO", "class_name": "Studio" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Studio"] }]
}
