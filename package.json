{
  "name": "voltune",
  "version": "1.0.0",
  "private": true,
  "description": "Natural, human-sounding text-to-speech and dialogue that runs entirely in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@huggingface/transformers": "3.8.1",
    "kokoro-js": "^1.2.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
